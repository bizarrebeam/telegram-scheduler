# Copy to .env and fill in. NEVER commit .env or paste secrets into chat.

# --- App ---
APP_ENV=dev
TZ=Asia/Jakarta

# --- Telegram ---
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric IDs (from @userinfobot). Only these users are allowed.
TELEGRAM_ALLOWED_USER_IDS=

# --- Supabase / Postgres ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Calendar + Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_CALENDAR_ID=primary
# Fernet key for encrypting refresh tokens at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- AI parser (optional; fallback parser works without it) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
